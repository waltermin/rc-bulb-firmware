diff --git a/src/user_main.c b/src/user_main.c
index 49f79ed..35ff23e 100644
--- a/src/user_main.c
+++ b/src/user_main.c
@@ -1298,6 +1298,20 @@ void Main_Init_AfterDelay_Unsafe(bool bStartAutoRunScripts) {
 
 	CMD_Init_Delayed();
 
+#if ENABLE_DRIVER_RCSWITCH
+	// rc-switch-firmware bring-up: bring up a command console on UART1 (the wire
+	// the bench jig reads) so logs come out and commands go in — OpenBeken
+	// normally logs on UART2. UART_PORT is set to UART1 in logging.c.
+	{
+		extern void CMD_UARTConsole_Init(void);
+		CFG_SetFlag(OBK_FLAG_CMD_ACCEPT_UART_COMMANDS, true);
+		CMD_UARTConsole_Init();
+	}
+	// Auto-start the RC monitor-mode relay driver at boot (OpenBeken normally
+	// requires an explicit startDriver / autoexec.bat).
+	DRV_StartDriver("RCSwitch");
+#endif
+
 	if (bStartAutoRunScripts) {
 		if (PIN_FindPinIndexForRole(IOR_IRRecv, -1) != -1 || PIN_FindPinIndexForRole(IOR_IRSend, -1) != -1
 			|| PIN_FindPinIndexForRole(IOR_IRRecv_nPup, -1) != -1) {
