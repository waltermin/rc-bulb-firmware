# Default sdkconfig for the bulb firmware. `idf.py build` seeds sdkconfig from
# this file. Regenerate/adjust via `idf.py menuconfig` if needed.

# --- Flash: 4 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Custom two-OTA partition table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Bootloader verifies the app image before boot; falls back on failure ---
CONFIG_BOOTLOADER_APP_TEST=n

# --- Keep the app small enough for a 0xF0000 (960 KB) slot; a minimal build is
#     far under this, but trim if you add features. ---
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
